{% extends 'documents/base_print.html' %}
{% load static %}
{% load document_filters %}

{% block document_body %}

<div class="info-grid">
    {% if doc.shipping_address %}
    <div class="info-col" style="width: 35%;">
        <div class="text-red mb-1" style="font-size: 11px;">Delivery To (Bill To):</div>
        <div style="font-size: 12px; font-weight: bold; margin-bottom: 2px;">{{ doc.contact.name }}</div>

        {% if doc.contact.address and doc.contact.address != 'N/A' %}
        <div style="font-size: 9.5px; margin-bottom: 4px; max-width: 95%;">
            {{ doc.contact.address|linebreaksbr }}
        </div>
        {% endif %}

        {% if doc.contact.gstin and doc.contact.gstin != 'N/A' %}
        <table style="font-size: 9.5px; border: none; margin-top: 3px;">
            <tr>
                <td class="bold" style="padding-right: 8px; border:none; padding-bottom: 2px;">GSTIN:</td>
                <td style="border:none; padding-bottom: 2px;">{{ doc.contact.gstin }}</td>
            </tr>
            <tr>
                <td class="bold" style="padding-right: 8px; border:none; padding-bottom: 2px;">State:</td>
                <td style="border:none; padding-bottom: 2px;">{{ doc.contact.gstin|gst_state }}</td>
            </tr>
        </table>
        {% endif %}
    </div>

    <div class="info-col" style="width: 35%; padding-left: 15px; border-left: 1px solid #ddd;">
        <div class="text-red mb-1" style="font-size: 11px;">Ship To:</div>
        <div style="font-size: 12px; font-weight: bold; margin-bottom: 2px;">{{ doc.shipping_name|default:doc.contact.name }}</div>
        <div style="font-size: 9.5px; margin-bottom: 4px; max-width: 95%;">
            {{ doc.shipping_address|linebreaksbr }}
        </div>
    </div>

    <div class="info-col" style="width: 30%; padding-left: 15px;">
        <div style="font-size: 18px; margin-bottom: 8px; font-weight: bold;">Delivery Challan</div>

        <table style="width: 100%; font-size: 9.5px; border: none;">
            <tr>
                <td class="bold" style="width: 50%; padding-bottom: 3px; border:none;">Challan No.:</td>
                <td style="padding-bottom: 3px; border:none;">{{ doc.number }}</td>
            </tr>
            <tr>
                <td class="bold" style="padding-bottom: 3px; border:none;">Date:</td>
                <td style="padding-bottom: 3px; border:none;">{{ doc.date|date:"d/m/Y" }}</td>
            </tr>
            <tr>
                <td class="bold" style="padding-bottom: 3px; border:none;">Place of Supply:</td>
                <td style="padding-bottom: 3px; border:none;">{{ doc.place_of_supply|default:"21-Odisha" }}</td>
            </tr>
        </table>
    </div>
    {% else %}
    <div class="info-col" style="width: 45%;">
        <div class="text-red mb-1" style="font-size: 12px;">Delivery To:</div>
        <div style="font-size: 14px; font-weight: bold; margin-bottom: 2px;">{{ doc.contact.name }}</div>

        {% if doc.contact.address and doc.contact.address != 'N/A' %}
        <div style="font-size: 10px; margin-bottom: 5px; max-width: 80%;">
            {{ doc.contact.address|linebreaksbr }}
        </div>
        {% endif %}

        {% if doc.contact.gstin and doc.contact.gstin != 'N/A' %}
        <table style="font-size: 10px; border: none; margin-top: 5px;">
            <tr>
                <td class="bold" style="padding-right: 10px; border:none;">GSTIN:</td>
                <td style="border:none;">{{ doc.contact.gstin }}</td>
            </tr>
            <tr>
                <td class="bold" style="padding-right: 10px; border:none;">State:</td>
                <td style="border:none;">{{ doc.contact.gstin|gst_state }}</td>
            </tr>
        </table>
        {% endif %}
    </div>

    <div class="info-col" style="width: 55%; padding-left: 15%;">
        <div style="font-size: 22px; margin-bottom: 10px;">Delivery Challan</div>

        <table style="width: 100%; font-size: 10px; border: none;">
            <tr>
                <td class="bold" style="width: 45%; padding-bottom: 4px; border:none;">Challan No.:</td>
                <td style="padding-bottom: 4px; border:none;">{{ doc.number }}</td>
            </tr>
            <tr>
                <td class="bold" style="padding-bottom: 4px; border:none;">Date:</td>
                <td style="padding-bottom: 4px; border:none;">{{ doc.date|date:"d/m/Y" }}</td>
            </tr>
            <tr>
                <td class="bold" style="padding-bottom: 4px; border:none;">Place of Supply:</td>
                <td style="padding-bottom: 4px; border:none;">{{ doc.place_of_supply|default:"21-Odisha" }}</td>
            </tr>
        </table>
    </div>
    {% endif %}
</div>

{% if doc.bill_from_name or doc.bill_from_address or doc.ship_from_name or doc.ship_from_address %}
<div style="width:100%; display:table; background:#f8fafc; border:1px solid #e2e8f0; border-radius:6px; padding:6px 10px; margin-top:6px; margin-bottom:8px; font-size:9.5px; page-break-inside:avoid;">
    <div style="display:table-row;">
        {% if doc.bill_from_name or doc.bill_from_address %}
        <div style="display:table-cell; width:50%; vertical-align:top; padding-right:10px;">
            <div style="color:#b91c1c; font-weight:bold; font-size:10px; text-transform:uppercase; margin-bottom:2px;">Bill From (Seller / Principal):</div>
            <div style="font-weight:bold; font-size:10.5px;">{{ doc.bill_from_name|default:'ODtech Solutions' }}</div>
            {% if doc.bill_from_address %}<div style="color:#334155; margin-top:2px;">{{ doc.bill_from_address|linebreaksbr }}</div>{% endif %}
            {% if doc.bill_from_gstin %}<div style="font-weight:bold; color:#475569; margin-top:2px;">GSTIN: {{ doc.bill_from_gstin }}</div>{% endif %}
        </div>
        {% endif %}
        {% if doc.ship_from_name or doc.ship_from_address %}
        <div style="display:table-cell; width:50%; vertical-align:top; padding-left:10px; {% if doc.bill_from_name or doc.bill_from_address %}border-left:1px dashed #cbd5e1;{% endif %}">
            <div style="color:#0891b2; font-weight:bold; font-size:10px; text-transform:uppercase; margin-bottom:2px;">Ship From (Dispatch Location / Warehouse):</div>
            <div style="font-weight:bold; font-size:10.5px;">{{ doc.ship_from_name|default:'Central Warehouse' }}</div>
            {% if doc.ship_from_address %}<div style="color:#334155; margin-top:2px;">{{ doc.ship_from_address|linebreaksbr }}</div>{% endif %}
            {% if doc.ship_from_gstin %}<div style="font-weight:bold; color:#475569; margin-top:2px;">GSTIN: {{ doc.ship_from_gstin }}</div>{% endif %}
        </div>
        {% endif %}
    </div>
</div>
{% endif %}

<!-- Transporter & Transport Reason Details Section (Full Width) -->
<div style="clear: both; width: 100%; margin-top: 10px; margin-bottom: 12px; border: 1px solid #1e293b; border-radius: 4px; background-color: #fafafa; padding: 8px 12px; box-sizing: border-box;">
    <div style="font-size: 11px; font-weight: bold; margin-bottom: 6px; border-bottom: 1px solid #cbd5e1; padding-bottom: 3px; color: #1e293b; text-transform: uppercase;">
        TRANSPORTER & TRANSPORT DETAILS
    </div>
    <table style="width: 100%; font-size: 9.5px; border: none; border-collapse: collapse;">
        <tr>
            <td style="width: 50%; border: none; padding: 2px 0;">
                <strong>Transporter Details:</strong> {{ doc.transporter_details|default:"Local Transportation" }}
            </td>
            <td style="width: 50%; border: none; padding: 2px 0;">
                <strong>E-Way Bill No. :</strong> {{ doc.eway_bill|default:"N/A" }}
            </td>
        </tr>
        <tr>
            <td style="border: none; padding: 2px 0;">
                <strong>Transporter Vehicle No. :</strong> {{ doc.vehicle_number|default:"N/A" }}
            </td>
            <td style="border: none; padding: 2px 0;">
                <strong>E-Way Bill Date :</strong> {% if doc.eway_bill_date %}{{ doc.eway_bill_date|date:"d/m/Y" }}{% else %}N/A{% endif %}
            </td>
        </tr>
        <tr>
            <td style="border: none; padding: 2px 0;">
                <strong>Transporter Doc No. :</strong> {{ doc.transport_doc_no|default:"N/A" }}
            </td>
            <td style="border: none; padding: 2px 0;">
                <strong>Transporter Doc Date :</strong> {% if doc.transport_doc_date %}{{ doc.transport_doc_date|date:"d/m/Y" }}{% else %}N/A{% endif %}
            </td>
        </tr>
        <tr>
            <td colspan="2" style="border: none; padding: 4px 0 0 0; border-top: 1px dashed #cbd5e1; margin-top: 4px;">
                <strong>Transport Reason :</strong> {{ doc.transport_reason|default:"Refilling only, No Commercial involvement." }}
            </td>
        </tr>
    </table>
</div>

<div style="clear: both; width: 100%;"></div>

{% include 'documents/print_items_table.html' %}

{# ── Pricing and Totals removed for Delivery Challan ── #}

<div class="info-grid" style="margin-top: 15px; margin-bottom: 10px;">
    <div class="info-col" style="width: 55%; padding-right: 20px;">
        {% if doc.terms_list %}
        <div class="text-red mb-1" style="font-size: 12px; font-weight: bold;">Terms And Conditions</div>
        <ol style="font-size: 9px; line-height: 1.4; padding-left: 14px; margin: 0;">
            {% for term in doc.terms_list %}
            <li style="margin-bottom: 2px;">{{ term }}</li>
            {% endfor %}
        </ol>
        {% endif %}
    </div>
    <div class="info-col" style="width: 45%; text-align: right; vertical-align: top;">
        <div style="font-size: 9px; display: inline-block; position: relative; text-align: center;">
            For : ODtech Solutions<br>
            <div
                style="position: relative; height: 75px; margin-top: 2px; margin-bottom: 2px; width: 150px; display: inline-block;">
                <img src="{{ stamp_url|default:'' }}{% if not stamp_url %}{% static 'img/stamp.png' %}{% endif %}"
                    alt="Stamp"
                    style="height: 75px; opacity: 0.8; position: absolute; top: 0; left: 50%; transform: translateX(-50%); z-index: 1;">
                <img src="{{ sign_url|default:'' }}{% if not sign_url %}{% static 'img/sign.png' %}{% endif %}"
                    alt="Signature"
                    style="height: 35px; position: absolute; top: 18px; left: 50%; transform: translateX(-50%); z-index: 2;">
            </div>
            <br>
            <strong>Authorized Signatory</strong>
        </div>
    </div>
</div>

{% endblock %}
